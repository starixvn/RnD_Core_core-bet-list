<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard2.0;net6.0</TargetFrameworks>
        <Version>1.0.0-beta-05</Version>
        <InformationalVersion>1.0.1</InformationalVersion>
        <PackageReleaseNotes>Integrate PLAY STAR (#208023)</PackageReleaseNotes>
        <Description>
            New bet list for PLAY STAR

            The result link should call this Javascript function: "showPlayStarBetDetails(transId, 'winlostDate', custId, transactionType);"            

            Which transactionType is:

            - 1, if the status is Won, Lose, Draw, or Refund

            - 2, if the status is Reject, or Void

            - 3, if the status is Running, or Waiting

            - otherwise, 0
        </Description>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Authors>Nexcel Solutions</Authors>
        <PackageTags>Fanex BetList</PackageTags>
        <PackageProjectUrl>https://nexdev.net/projects/p111074/wiki/082024_-_PLAY_STAR_-_Bet_List__Results</PackageProjectUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="TplNetCore" Version="1.0.0" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Fanex.BetList.RNGCore\Fanex.BetList.RNGCore.csproj" />
    </ItemGroup>
</Project>