<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard2.0;net6.0</TargetFrameworks> 
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>        
        <Version>3.0.6.4-betbuilderPlus-11</Version>
        <InformationalVersion>3.0.6.4</InformationalVersion>
        <PackageReleaseNotes>Add BetBuilder Plus for Hybrid Parlay (#242225)</PackageReleaseNotes>
        <Authors>Nexcel Solutions</Authors>
        <PackageTags>Fanex BetList</PackageTags>
        <PackageProjectUrl>https://nexdev.net/projects/fanex-betlistcore/wiki/Core_Bet_List</PackageProjectUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="BetListNPOI" Version="2.6.0" />
      <PackageReference Include="System.Runtime.Caching" Version="6.0.0" />
      <PackageReference Include="TplNetCore" Version="1.0.0" />    
    </ItemGroup>
    <ItemGroup>
      <Compile Update="App_GlobalResources\CoreBetList.designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>CoreBetList.resx</DependentUpon>
      </Compile>
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Update="App_GlobalResources\CoreBetList.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>CoreBetList.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>    
</Project>