<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard2.0;net6.0</TargetFrameworks> 
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AssemblyVersion>3.0.1.0</AssemblyVersion>
        <FileVersion>3.0.1.0</FileVersion>
        <Version>3.0.1.0-MaxPayout-02</Version>
        <PackageReleaseNotes>Company Max Payout Alert(#194491)</PackageReleaseNotes>
        <Description>
          Add 3 css classes:
            .icon-max-payout {
            background: url(Images/icon-info-circle.png) no-repeat scroll center center transparent;
            display: inline-block;
            height: 16px;
            width: 16px;
            position: relative;
            top: 3px;
            margin-right: 2px;
            cursor: pointer;
        }

        .max-payout {
            color: #B50000;
            font-style: italic;
        }

        .max-payout &gt; span {
            margin-left: 4px;
        }
        </Description>
        <Authors>Nexcel Solutions</Authors>
        <PackageTags>Fanex BetList</PackageTags>
        <PackageProjectUrl>https://nexdev.net/projects/fanex-betlistcore/wiki/Core_Bet_List</PackageProjectUrl>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="BetListNPOI" Version="2.6.0" />
      <PackageReference Include="System.Runtime.Caching" Version="6.0.0" />
      <PackageReference Include="TplNetCore" Version="1.0.0" />    
    </ItemGroup>    
</Project>