<?xml version="1.0"?>
<configuration>
    <configSections>
        <section name="Fanex.Data.DbSettingProvider" type="Fanex.Data.Configuration.DbSettingProviderConfigurationSection, Fanex.Data"/>
    </configSections>
    <Fanex.Data.DbSettingProvider default="XmlDbSettingProvider">
        <providers>
            <add
            name="XmlDbSettingProvider"
            type="Fanex.Data.Configuration.XmlDbSettingProvider, Fanex.Data"
            resourcePath="SpName.xml"
            enableWatching = "1"
            />
        </providers>
    </Fanex.Data.DbSettingProvider>
    <connectionStrings>
        <add name="nexhr" connectionString="packet size=4096; Data Source=10.19.10.71;Initial Catalog=NexHRMDemo;integrated security=false; user id=sa; password=1234aa" providerName="System.Data.SqlClient" />
    </connectionStrings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
    </startup>
</configuration>
