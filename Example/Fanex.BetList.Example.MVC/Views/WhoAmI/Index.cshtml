@{
    ViewData["Title"] = "Who Am I?";
}

<div class="container">
    <h2>Who Am I?</h2>
    
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Server Information</h5>
                    <p><strong>Web Name:</strong> @ViewBag.ServerName</p>
                    <p><strong>Port:</strong> @ViewBag.Port</p>
                    <p><strong>Server IP:</strong> @ViewBag.ServerIP</p>
                    <p><strong>Server Time:</strong> @ViewBag.ServerTime</p>
                </div>
            </div>
        </div>
        
        <div class="col-md-6">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Client Information</h5>
                    <p><strong>Client IP:</strong> @ViewBag.ClientIP</p>
                    <p><strong>X-Forwarded-For:</strong> @ViewBag.ForwardedFor</p>
                    <p><strong>X-Real-IP:</strong> @ViewBag.RealIP</p>
                    <p><strong>Via:</strong> @ViewBag.Via</p>
                    <p><strong>Proxy-Connection:</strong> @ViewBag.ProxyConnection</p>
                </div>
            </div>
        </div>
    </div>
</div>
