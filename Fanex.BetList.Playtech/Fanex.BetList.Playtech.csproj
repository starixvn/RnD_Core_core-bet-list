<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net461;netstandard2.0;net6.0</TargetFrameworks>
        <Version>1.0.1-jackpot-06</Version>
        <InformationalVersion>1.0.1</InformationalVersion>
        <PackageReleaseNotes>Support Playtech Jackpot(#234576)</PackageReleaseNotes>
        <Description>
            New bet list for Playtech

            The result link should call this Javascript function: "showPlaytechBetDetails(transId, 'winlostDate', custId, transactionType);", which transactionType is:

            - 1, if the status is Won, Lose, Draw, or Refund

            - 2, if the status is Reject, or Void

            - 3, if the status is Running, or Waiting

            - otherwise, 0</Description>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <Authors>Nexcel Solutions</Authors>
        <PackageTags>Fanex BetList</PackageTags>
        <PackageProjectUrl>https://nexdev.net/projects/p111076/wiki/102024_-_Playtech_-_System_Overview</PackageProjectUrl>
      <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="TplNetCore" Version="1.0.0" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Fanex.BetList.RNGCore\Fanex.BetList.RNGCore.csproj" />
    </ItemGroup>
    
</Project>