@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Factories
@using Fanex.BetList.Core.Builder
@using Fanex.BetList.Example.MVC.ViewModel
@using Fanex.BetList.Core.TicketHelper
@using Fanex.BetList.Example.Extension.BetListHTMLBuilderExt
@model BetListData
@{
    ViewBag.Title = "Example Bet List";

    IList<ITicket> tickets = Model.Tickets;
    List<ITicketData> ticketData = Model.TicketData;

    BetListHTMLFactory factory = new BetListHTMLFactory();
    BetListHTMLBuilder builder = factory.CreateBuilder();

    ITicketHelper ticketHelper = new Fanex.BetList.Example.Data.TicketHelperStub();

    GetCachePropertyById funcGetOddsTypeName = CacheRef.GetOddsTypeName;
    
    var isShowScoreMap = Model.BetTypeId == 145 || Model.BetTypeId == 146 || Model.BetTypeId == 151;

    var rowIndex = 0;
}
@section head
{
    <link rel="Stylesheet" href=@Url.Content("Content/CoreBetList.css") />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/jquery-1.9.0.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.min.js" type="text/javascript"></script>
}
@using (Html.BeginForm())
{ 
    <div class="panel panel-default">
        <div class="panel-heading">
            <b>Core Bet List Demo For BetRadar </b><span class="label label-warning">@Html.ActionLink("Export list to excel", "ExportExcel")</span>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-lg-6">
                    @Html.DropDownListFor(m => m.BetTypeId, new List<SelectListItem>()
{
    new SelectListItem{Value="0",Text="All"},
    new SelectListItem{Value="133",Text="Home to Win Both Halves"},
    new SelectListItem{Value="134",Text="Away to Win Both Halves"},
    new SelectListItem{Value="135",Text="Penalty Shootout Yes/No"},
    new SelectListItem{Value="140",Text="Highest Scoring Half"},
    new SelectListItem{Value="141",Text="Highest Scoring Half Home Team"},
    new SelectListItem{Value="142",Text="Highest Scoring Half Away Team"},
    new SelectListItem{Value="145",Text="Both Teams to Score"},
    new SelectListItem{Value="146",Text="2nd Half Both Teams to Score"},
    new SelectListItem{Value="147",Text="Home to Score in Both Halves"},
    new SelectListItem{Value="148",Text="Away to Score in Both Halves"},
    new SelectListItem{Value="149",Text="Home to Win Either Half"},
    new SelectListItem{Value="150",Text="Away to Win Either Half"},
    new SelectListItem{Value="151",Text="1st Half Double Chance"},
    new SelectListItem{Value="152",Text="Half Time/Full Time Correct Score"}
}, new { @class = "form-control" })
                </div>
                <div class="col-lg-1">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                </div>
            </div>
        </div>
    </div>
}
<table class="table table-striped table-bordered table-condensed">
    <thead>
        <tr class="success">
            <th>
                #
            </th>
            <th>
                Trans.Time
            </th>
            <th>
                Username
            </th>
            <th>
                Choice
            </th>
            <th>
                Odds
            </th>
            <th>
                Stake
            </th>
            <th>
                Status
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in tickets)
        {
            rowIndex++;        
            
            <tr>
                <td class="text-center">
                    @rowIndex
                </td>
                <td class="c">
                    @Html.Raw(builder.BuildTrans(ticket))
                </td>
                <td class="text-center">
                    @Html.Raw(builder.BuildUsername(ticket))
                </td>
                <td class="text-right">
                    @Html.Raw(builder.BuildChoice(ticket, ticketHelper, ticketData, isShowScoreMap))
                </td>
                <td class="text-center">
                    @Html.Raw(builder.BuildOdds(ticket, ticketData, funcGetOddsTypeName))
                </td>
                <td class="text-center">
                    @Html.Raw(builder.BuildStake(ticket))
                </td>
                <td class="text-center">
                    @Html.Raw(builder.BuildStatus(ticket, ticketHelper, ticketData, true))
                </td>
            </tr>
        }
    </tbody>
</table>
