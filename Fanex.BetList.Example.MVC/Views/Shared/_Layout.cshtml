<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="Stylesheet" href="~/Content/CoreBetList.css" />
    <link href="~/Content/Allbet.css" rel="stylesheet" />
    <link href="~/Content/Microgaming.css" rel="stylesheet" />
    <link href="~/Content/AGCasino.css" rel="stylesheet" />
    <link href="~/Content/CockFighting.css" rel="stylesheet" />
    <link href="~/Content/Lucky3.css" rel="stylesheet" />
    <link href="~/Content/bullfighting.css" rel="stylesheet" />
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/jquery-1.9.0.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.min.js" type="text/javascript"></script>
    @RenderSection("head", false)
</head>
<body>
    <div class="navbar-header">
        <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
            <span class="sr-only">Toggle navigation</span> <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
        </button>
        <a class="navbar-brand" href="~/BetList/All">Core BetList</a>
    </div>
    <div class="navbar-collapse collapse">
        <ul class="nav navbar-nav">
            <li><a href="~/BetList/PHAIO3">PH AIO Phase 3</a></li>
            <li><a href="~/BetList/FastMarkets2">FastMarkets 2</a></li>
            <li><a href="~/BetList/BetRadarVirtualSports">Bet Radar Virtual Sports</a></li>
            <li><a href="~/BetList/PP">PP</a></li>
            <li><a href="~/BetList/Keno">Keno</a></li>
            <li><a href="~/BetList/Parlay">Parlay</a></li>
            <li><a href="~/BetList/PokerGames">Poker Games</a></li>
            <li><a href="~/BetList/UpcomingSports">Upcoming Sports</a></li>
            <li><a href="~/BetList/SettlementStatus">Settlement Status</a></li>
            <li><a href="~/BetList/ESports2">E-Sports 2.0</a></li>
            <li><a href="~/BetList/Happy5">Happy 5</a></li>
            <li><a href="~/BetList/ESports2InPlay">E-Sports 2.0 InPlay</a></li>
        </ul>
    </div>
    @RenderBody()
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
</body>
</html>